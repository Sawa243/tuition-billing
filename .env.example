# Скопируйте в .env и подставьте свои значения. Файл .env в репозиторий не попадает.
# Все значения ниже — заглушки, а не рабочие ключи.

# --- база данных ---
POSTGRES_DB=tuition_billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=<пароль базы>
POSTGRES_PORT=55432

# --- ключ подписи токенов доступа ---
# Не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SIGNING_KEY=<длинная случайная строка>

# --- платёжный шлюз ---
# Идентификатор магазина и секретный ключ. У настоящего провайдера их выдают
# в личном кабинете; здесь они задают вход в учебный эмулятор.
GATEWAY_SHOP_ID=<идентификатор магазина>
GATEWAY_SECRET_KEY=<секретный ключ магазина>
GATEWAY_FEE_PERCENT=2.8
GATEWAY_PORT=5090

# --- биллинг ---
BILLING_PORT=5080
# Внешний адрес: на него шлюз возвращает плательщика после оплаты.
BILLING_PUBLIC_URL=http://localhost:5080
# Сеть, с которой принимаются уведомления шлюза. Пусто — проверка выключена,
# так можно только при локальной разработке.
WEBHOOK_ALLOWED_IP_0=

# --- демонстрационные данные ---
# При первом запуске создаются бухгалтер и два обучающихся с этими паролями.
# В рабочей установке SEED_ENABLED ставится в false.
SEED_ENABLED=true
SEED_ACCOUNTANT_PASSWORD=<пароль бухгалтера>
SEED_STUDENT_PASSWORD=<пароль обучающегося>
