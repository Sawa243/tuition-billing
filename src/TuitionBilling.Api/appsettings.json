{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/billing-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Billing": ""
  },
  "Jwt": {
    "Issuer": "tuition-billing",
    "Audience": "tuition-billing",
    "SigningKey": "",
    "LifetimeMinutes": 120
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5090",
    "ShopId": "",
    "SecretKey": "",
    "TimeoutSeconds": 15
  },
  "Billing": {
    "PublicUrl": "http://localhost:5080",
    "OrganizationName": "Университет «Синергия»",
    "ReceiptVatCode": 1,
    "OutboxMaxAttempts": 5,
    "OutboxPollSeconds": 5,
    "WebhookAllowedIps": []
  },
  "Reconciliation": {
    "Enabled": true,
    "RunAfterHourUtc": 1,
    "CheckIntervalMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": false
  }
}
